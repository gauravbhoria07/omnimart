# ==========================================
# OmniMart Root .gitignore
# Production-ready Git ignore rules
# ==========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
scratch/node_modules/

# Production build outputs
dist/
backend/dist/
frontend/dist/
dist-ssr/
build/

# Environment Variables & Secrets (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs and Debug files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage and Test Output
coverage/
backend/coverage/
frontend/coverage/
.nyc_output/

# IDE & OS Files
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
ehthumbs.db

# Temporary & Scratch files
scratch/
*.tmp
*.temp

