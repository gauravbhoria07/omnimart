# ==========================================
# OmniMart Global Environment Reference (Portfolio Demo)
# Copy these values into backend/.env and frontend/.env respectively
# ==========================================

# -----------------
# Backend Variables (backend/.env or Render Environment)
# -----------------
PORT=3001
NODE_ENV=production
# Strong random secret key for JWT token signing (minimum 32 characters)
JWT_SECRET="generate_a_secure_random_jwt_secret_here_min_32_characters"
# Deployed Frontend URL (Vercel domain)
FRONTEND_URL="https://your-omnimart-app.vercel.app"
# Optional Demo Password override for portfolio reviewers
DEMO_PASSWORD="your_demonstration_password_here"

# -----------------
# Frontend Variables (frontend/.env or Vercel Environment)
# -----------------
# Deployed Backend API URL (Render web service URL)
VITE_API_URL="https://your-omnimart-backend.onrender.com"
