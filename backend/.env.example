# Server Configuration
PORT=3001
NODE_ENV=production

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET="your_strong_random_jwt_secret_key_min_32_chars"

# Frontend Application URL (e.g. your Vercel deployment URL)
# Multiple comma-separated URLs can be provided
FRONTEND_URL="https://your-omnimart-app.vercel.app"

# Demonstration Password Configuration (for portfolio reviewer testing)
# Leave unset to strictly use the seeded bcrypt hashes in users.json,
# or set to specify an environment-level demonstration password.
DEMO_PASSWORD="your_demonstration_password_here"
